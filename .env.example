# ==============================================================================
# Autonomous YouTube Video Pipeline - Environment Configuration
# ==============================================================================

# Application Environment: development | production
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Scriptwriting, Research & Metadata)
# ------------------------------------------------------------------------------
# Supported: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Alternative LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Voiceover / Speech Synthesis Configuration
# ------------------------------------------------------------------------------
# Supported: google_tts | gemini_audio | elevenlabs | openai
TTS_PROVIDER=google_tts

# Google Cloud Text-to-Speech (Service Account credentials JSON path or API Key)
GOOGLE_APPLICATION_CREDENTIALS=config/google_credentials.json
GOOGLE_TTS_VOICE_NAME=en-US-Journey-F
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_SPEAKING_RATE=1.05

# ElevenLabs (Alternative)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI TTS (Alternative)
OPENAI_TTS_VOICE=alloy

# ------------------------------------------------------------------------------
# Visuals & Image Generation Configuration
# ------------------------------------------------------------------------------
# Supported: imagen | gemini | openai | slide_engine
IMAGE_PROVIDER=slide_engine
IMAGEN_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Video Production Specifications
# ------------------------------------------------------------------------------
VIDEO_RESOLUTION_WIDTH=1920
VIDEO_RESOLUTION_HEIGHT=1080
VIDEO_FPS=30
MIN_WORDS=1400
MAX_WORDS=1800
WORDS_PER_MINUTE=145
MUSIC_VOLUME=0.08

# ------------------------------------------------------------------------------
# YouTube Data API v3 Configuration (OAuth 2.0)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/token.json
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_CATEGORY_ID=28
YOUTUBE_AI_DISCLOSURE=true
